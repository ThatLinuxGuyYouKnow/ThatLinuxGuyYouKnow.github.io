<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background gradient -->
    <radialGradient id="bgGradient" cx="50%" cy="50%" r="70%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:1" />
    </radialGradient>
  </defs>
  
  <!-- Dark square background with subtle rounded corners -->
  <rect x="10" y="10" width="380" height="380" rx="40" ry="40" fill="url(#bgGradient)" stroke="#2a2a2a" stroke-width="1"/>
  
  <!-- Stylized letter A using geometric construction -->
  <g transform="translate(200, 200)">
    <!-- Main A strokes - thicker -->
    <path d="M -65 85 L -22 -75 L 0 -85 L 22 -75 L 65 85" 
          fill="none" 
          stroke="#e8e8e8" 
          stroke-width="14" 
          stroke-linecap="round" 
          stroke-linejoin="round"/>
    
    <!-- Crossbar - thicker -->
    <line x1="-38" y1="0" x2="38" y2="0" 
          stroke="#e8e8e8" 
          stroke-width="12" 
          stroke-linecap="round"/>
    
    <!-- Inner accent lines - slightly thicker for balance -->
    <path d="M -48 65 L -14 -55" 
          stroke="#404040" 
          stroke-width="3" 
          stroke-linecap="round"/>
    <path d="M 48 65 L 14 -55" 
          stroke="#404040" 
          stroke-width="3" 
          stroke-linecap="round"/>
  </g>
  
  <!-- Minimal accent dot -->
  <circle cx="200" cy="285" r="5" fill="#666"/>
  
  <!-- Subtle border frame -->
  <rect x="25" y="25" width="350" height="350" rx="30" ry="30" fill="none" stroke="#333" stroke-width="0.5" opacity="0.5"/>
</svg>
